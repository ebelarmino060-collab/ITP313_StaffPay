{{> leaveNav}}

<div class="card">
  <form class="filter-bar" method="get" action="/leaves/balances" data-autosubmit>
    <select class="input" name="year">{{options years year}}</select>
    <select class="input" name="department_id">{{options departments filters.department_id placeholder="All departments" value="id" label="name"}}</select>
    <div class="search-input">{{icon "search" 16}}<input class="input" type="search" name="search" value="{{filters.search}}" placeholder="Search employee…"></div>
  </form>

  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Employee</th><th>Vacation (left / total)</th><th>Sick (left / total)</th><th>Emergency (left / total)</th><th></th></tr></thead>
      <tbody>
        {{#each rows}}
        <tr>
          <td><div class="person-cell">{{avatar employee.full_name employee.photo_url 34}}<div><strong>{{employee.full_name}}</strong><span class="text-muted">{{employee.employee_code}} · {{employee.department.name}}</span></div></div></td>
          {{#each balances}}
          <td>
            {{#if this}}
            <button type="button" class="balance-cell" title="Adjust balance" data-modal="#balance-modal" data-action="/leaves/balances/{{id}}/update" data-subtitle="{{employee_name}} · {{leaveType leave_type}} · {{year}}" data-record="{{json this}}">
              <strong class="{{#unless (gt remaining 0)}}text-danger{{/unless}}">{{remaining}}</strong><small>/ {{allocated}}</small>{{icon "pencil" 12}}
            </button>
            {{else}}—{{/if}}
          </td>
          {{/each}}
          <td class="text-right"><a href="/leaves/history/{{employee.id}}?year={{@root.year}}" class="btn btn-ghost btn-sm">{{icon "history" 14}}<span>History</span></a></td>
        </tr>
        {{else}}
        <tr><td colspan="5" class="table-empty">No employees found.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{> pagination}}
</div>

{{#> modal id="balance-modal" title="Adjust Leave Balance" action="" size="sm"}}
<div class="form-grid">
  <label class="field"><span class="field-label">Allocated days</span><input class="input" type="number" name="allocated" step="0.5" min="0" required></label>
  <label class="field"><span class="field-label">Used days</span><input class="input" type="number" name="used" step="0.5" min="0" required></label>
</div>
{{/modal}}
