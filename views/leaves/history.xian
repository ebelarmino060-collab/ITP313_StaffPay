{{> leaveNav}}

<div class="page-header">
  <div>
    <h2>{{employee.full_name}}</h2>
    <p class="text-muted">{{employee.employee_code}} · {{employee.department.name}} · Leave history</p>
  </div>
  <div class="page-actions"><a href="/leaves/balances" class="btn btn-secondary">{{icon "arrow-left" 16}}<span>Back</span></a></div>
</div>

<div class="balance-row balance-row-lg">
  {{#each balances}}<div class="balance-pill"><span>{{leaveType leave_type}} ({{year}})</span><strong>{{remaining}}</strong><small>{{used}} used of {{allocated}}</small></div>{{/each}}
</div>

<div class="card">
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Type</th><th>Dates</th><th class="text-right">Days</th><th>Reason</th><th>Status</th><th>Reviewed by</th><th>Remarks</th></tr></thead>
      <tbody>
        {{#each requests}}
        <tr>
          <td>{{leaveType leave_type}}</td>
          <td>{{date start_date}} – {{date end_date}}</td>
          <td class="text-right">{{days}}</td>
          <td class="cell-wrap">{{reason}}</td>
          <td>{{badge status "request"}}</td>
          <td>{{default reviewer.name "—"}}</td>
          <td class="cell-wrap">{{default remarks "—"}}</td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="table-empty">No leave requests filed.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>
