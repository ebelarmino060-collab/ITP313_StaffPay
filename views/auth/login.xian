<div class="login-page">
  <div class="login-hero">
    <div class="login-hero-inner">
      <div class="login-brand">
        {{#if hotel.logoUrl}}<img src="{{hotel.logoUrl}}" alt="" class="brand-logo">{{else}}<span class="brand-mark large">S</span>{{/if}}
        <div>
          <h1>StaffPay</h1>
          <span>{{hotel.name}}</span>
        </div>
      </div>
      <h2>Hotel Staff Attendance &amp; Payroll Management</h2>
      <ul class="login-features">
        <li>Real-time time in / time out with late, undertime and overtime detection</li>
        <li>Shift scheduling for morning, afternoon and night operations</li>
        <li>Automated payroll with night differential, holiday pay and contributions</li>
        <li>Leave management, payslips and exportable reports</li>
      </ul>
    </div>
  </div>

  <div class="login-panel">
    <form class="login-card" method="post" action="/login" id="login-form">
      {{> csrf}}
      <input type="hidden" name="next" value="{{next}}">
      <h3>Sign in to your account</h3>
      <p class="text-muted">Use the credentials provided by your HR department.</p>

      <label class="field">
        <span class="field-label">Email address</span>
        <div class="input-icon">
          {{icon "mail" 16}}
          <input class="input" type="email" name="email" value="{{email}}" autocomplete="username" placeholder="you@staffpay.com" required autofocus>
        </div>
      </label>
      <label class="field">
        <span class="field-label">Password</span>
        <div class="input-icon">
          {{icon "lock" 16}}
          <input class="input" type="password" name="password" autocomplete="current-password" placeholder="••••••••" required>
        </div>
      </label>

      <button type="submit" class="btn btn-primary btn-block">{{icon "log-in" 16}}<span>Sign in</span></button>

      <div class="demo-accounts">
        <span>Demo accounts (click to fill):</span>
        {{#each demo}}
        <button type="button" data-demo-email="{{email}}" data-demo-password="{{password}}"><strong>{{role}}</strong> {{email}}</button>
        {{/each}}
      </div>
    </form>
  </div>
</div>
<script>
  document.querySelectorAll('[data-demo-email]').forEach(function (b) {
    b.addEventListener('click', function () {
      var f = document.getElementById('login-form');
      f.email.value = b.dataset.demoEmail;
      f.password.value = b.dataset.demoPassword;
    });
  });
</script>
