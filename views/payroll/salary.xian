{{> payrollNav}}

<div class="card">
  {{#unless me.isAdmin}}<div class="alert alert-info">Salary configuration is managed by the administrator. You have view-only access.</div>{{/unless}}
  <form class="filter-bar" method="get" action="/payroll/salary" data-autosubmit>
    <input type="hidden" name="kind" value="{{kind}}">
    <div class="tabs-inline">
      <a href="/payroll/salary?kind=allowances" class="{{active isAllowances}}">Allowances &amp; Incentives</a>
      <a href="/payroll/salary?kind=deductions" class="{{active (not isAllowances)}}">Other Deductions</a>
    </div>
    <div class="search-input">{{icon "search" 16}}<input class="input" type="search" name="search" value="{{filters.search}}" placeholder="Search employee or name…"></div>
    {{#if me.isAdmin}}
    <div class="filter-actions"><button type="button" class="btn btn-primary" data-modal="#salary-modal" data-title="Add {{#if isAllowances}}Allowance{{else}}Deduction{{/if}}" data-action="/payroll/salary/{{kind}}">{{icon "plus" 16}}<span>Add {{#if isAllowances}}Allowance{{else}}Deduction{{/if}}</span></button></div>
    {{/if}}
  </form>

  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Employee</th><th>{{#if isAllowances}}Allowance{{else}}Deduction{{/if}}</th><th>{{#if isAllowances}}Category / Taxable{{else}}Type{{/if}}</th>{{#unless isAllowances}}<th>Effective</th>{{/unless}}<th class="text-right">Amount / Period</th><th>Status</th>{{#if me.isAdmin}}<th></th>{{/if}}</tr></thead>
      <tbody>
        {{#each items}}
        <tr>
          <td><div class="person-cell">{{avatar employee.full_name employee.photo_url 34}}<div><strong>{{employee.full_name}}</strong><span class="text-muted">{{employee.employee_code}} · {{employee.department.name}}</span></div></div></td>
          <td><strong>{{name}}</strong></td>
          <td>{{#if @root.isAllowances}}{{#if (eq category "incentive")}}{{badge label="Incentive" tone="blue"}}{{else}}{{badge label="Allowance" tone="neutral"}}{{/if}} {{#if is_taxable}}taxable{{else}}non-taxable{{/if}}{{else}}{{deductionType type}}{{/if}}</td>
          {{#unless @root.isAllowances}}<td>{{#if (or start_date end_date)}}{{date start_date}} – {{#if end_date}}{{date end_date}}{{else}}ongoing{{/if}}{{else}}Always{{/if}}</td>{{/unless}}
          <td class="text-right">{{money amount}}</td>
          <td>{{#if is_active}}{{badge label="Active" tone="success"}}{{else}}{{badge label="Inactive" tone="muted"}}{{/if}}</td>
          {{#if @root.me.isAdmin}}
          <td class="text-right"><div class="row-actions">
            <button type="button" class="btn btn-ghost btn-sm btn-icon" title="Edit" data-modal="#salary-modal" data-title="Edit {{name}}" data-subtitle="{{employee.full_name}}" data-action="/payroll/salary/{{@root.kind}}/{{id}}/update" data-record="{{json form}}">{{icon "pencil" 16}}</button>
            {{> deleteButton action=(concat "/payroll/salary/" @root.kind "/" id "/delete") message=(concat "Remove " name " of " employee.full_name "?") confirmLabel="Remove"}}
          </div></td>
          {{/if}}
        </tr>
        {{else}}
        <tr><td colspan="7" class="table-empty">{{icon "inbox" 28}}<div>Nothing configured yet.</div></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{> pagination}}
</div>

{{#if me.isAdmin}}
{{#> modal id="salary-modal" title="Add" action="" size="lg" subtitle="Amounts are applied every pay period."}}
<div class="form-sections">
  <div class="form-grid">
    <label class="field"><span class="field-label">Name <em>*</em></span><input class="input" name="name" required maxlength="100" placeholder="{{#if @root.isAllowances}}e.g. Meal Allowance{{else}}e.g. SSS Salary Loan{{/if}}"></label>
    <label class="field"><span class="field-label">Amount per pay period <em>*</em></span><input class="input" type="number" name="amount" min="0" step="0.01" required></label>
    {{#if @root.isAllowances}}
    <label class="field"><span class="field-label">Category</span><select class="input" name="category"><option value="allowance">Allowance (e.g. meal, transport)</option><option value="incentive">Incentive (e.g. perfect attendance, sales)</option></select></label>
    <label class="checkbox"><input type="checkbox" name="is_taxable" value="1"><span>Taxable</span></label>
    {{else}}
    <label class="field"><span class="field-label">Type</span><select class="input" name="type">{{options @root.opts.deductionTypes "other"}}</select></label>
    <div></div>
    <label class="field"><span class="field-label">Start date (optional)</span><input class="input" type="date" name="start_date"></label>
    <label class="field"><span class="field-label">End date (optional)</span><input class="input" type="date" name="end_date"></label>
    {{/if}}
    <label class="checkbox"><input type="checkbox" name="is_active" value="1" checked><span>Active</span></label>
  </div>
  <fieldset data-show-when-new>
    <legend>Employees</legend>
    <div class="picker-toolbar">
      <select class="input" data-filter-target="#salary-employees">{{options @root.departments placeholder="All departments" value="id" label="name"}}</select>
      <input class="input" type="search" placeholder="Filter by name…" data-filter-list="#salary-employees">
      <label class="checkbox"><input type="checkbox" data-check-all="#salary-employees input[type=checkbox]"><span>Select all shown</span></label>
    </div>
    <div class="employee-picker" id="salary-employees">
      {{#each @root.employees}}<label class="checkbox" data-group="{{department_id}}"><input type="checkbox" name="employee_ids[]" value="{{id}}"><span>{{option_label}}</span></label>{{/each}}
    </div>
  </fieldset>
</div>
{{/modal}}
{{/if}}
