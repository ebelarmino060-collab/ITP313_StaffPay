{{!-- Add / edit employee modal (administrator). Uses departments, positions, shifts. --}}
{{#> modal id="employee-modal" title="Add New Employee" action="/employees" size="lg" submit="Save employee" multipart=true subtitle="Employee ID is generated automatically when left blank."}}
<div class="form-sections">
  <fieldset>
    <legend>Personal Information</legend>
    <div class="photo-field">
      <label class="field">
        <span class="field-label">Profile photo</span>
        <input type="file" name="photo" accept="image/*" class="input">
        <span class="field-hint">JPG or PNG, up to 2 MB</span>
      </label>
    </div>
    <div class="form-grid cols-3">
      <label class="field"><span class="field-label">First name <em>*</em></span><input class="input" name="first_name" required maxlength="80"></label>
      <label class="field"><span class="field-label">Middle name</span><input class="input" name="middle_name" maxlength="80"></label>
      <label class="field"><span class="field-label">Last name <em>*</em></span><input class="input" name="last_name" required maxlength="80"></label>
      <label class="field"><span class="field-label">Gender</span><select class="input" name="gender">{{options @root.opts.genders placeholder="Select…"}}</select></label>
      <label class="field"><span class="field-label">Birth date</span><input class="input" type="date" name="birth_date"></label>
      <label class="field"><span class="field-label">Contact number</span><input class="input" name="contact_number" placeholder="09xx xxx xxxx"></label>
      <label class="field span-2"><span class="field-label">Email address</span><input class="input" type="email" name="email" maxlength="150"></label>
      <label class="field"><span class="field-label">Employee ID</span><input class="input" name="employee_code" placeholder="Auto (EMP001)" maxlength="30"></label>
      <label class="field span-3"><span class="field-label">Home address</span><textarea class="input" name="address" rows="2"></textarea></label>
    </div>
  </fieldset>

  <fieldset>
    <legend>Employment</legend>
    <div class="form-grid cols-3">
      <label class="field"><span class="field-label">Department</span>
        <select class="input" name="department_id" data-department-select>{{options @root.departments placeholder="Select department…" value="id" label="name"}}</select></label>
      <label class="field"><span class="field-label">Position</span>
        <select class="input" name="position_id" data-position-select>
          <option value="">Select position…</option>
          {{#each @root.positions}}<option value="{{id}}" data-department="{{department_id}}" data-salary="{{default_salary}}">{{title}} ({{department_name}})</option>{{/each}}
        </select></label>
      <label class="field"><span class="field-label">Date hired <em>*</em></span><input class="input" type="date" name="date_hired" required></label>
      <label class="field"><span class="field-label">Employment status <em>*</em></span><select class="input" name="employment_status" required>{{options @root.opts.employmentStatus "active"}}</select></label>
      <label class="field"><span class="field-label">Employment type <em>*</em></span><select class="input" name="employment_type" required>{{options @root.opts.employmentTypes "full_time"}}</select></label>
      <label class="field"><span class="field-label">Basic salary (monthly) <em>*</em></span><input class="input" type="number" name="basic_salary" min="0" step="0.01" required><span class="field-hint">Daily and hourly rates are derived from this (Settings → Payroll).</span></label>
    </div>
  </fieldset>

  <fieldset data-show-when-new>
    <legend>Work Schedule (optional)</legend>
    <div class="form-grid">
      <label class="field"><span class="field-label">Shift</span><select class="input" name="shift_id">{{options @root.shifts placeholder="Assign later" value="id" label="label"}}</select></label>
      <div class="field"><span class="field-label">Working days</span>
        <div class="weekday-picker">
          {{#each @root.opts.weekdays}}<label><input type="checkbox" name="working_days[]" value="{{value}}" {{#if (lt value 7)}}checked{{/if}}><span>{{short}}</span></label>{{/each}}
        </div>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Login Account</legend>
    <div data-show-if="has_account" hidden>
      <div class="form-grid">
        <p class="text-muted span-2">This employee already has a login account. Leave the password blank to keep it.</p>
        <label class="field"><span class="field-label">Reset password</span><input class="input" type="password" name="new_password" autocomplete="new-password" minlength="8"><span class="field-hint">At least 8 characters</span></label>
      </div>
    </div>
    <div data-hide-if="has_account">
      <label class="checkbox"><input type="checkbox" name="create_account" value="1" data-toggle-target="#account-fields"><span>Create a login account so the employee can access StaffPay</span></label>
      <div class="form-grid mt-2" id="account-fields" hidden>
        <label class="field"><span class="field-label">Password</span><input class="input" type="password" name="password" autocomplete="new-password" minlength="8"><span class="field-hint">Login uses the email above. At least 8 characters.</span></label>
        <label class="field"><span class="field-label">Role</span><select class="input" name="role">{{options @root.opts.roles "employee"}}</select></label>
      </div>
    </div>
  </fieldset>
</div>
{{/modal}}
