{{> attendanceNav}}

<div class="card">
  <form class="filter-bar" method="get" action="/attendance/corrections" data-autosubmit>
    <select class="input" name="status">{{options opts.requestStatus filters.status placeholder="All"}}</select>
    <div class="search-input">{{icon "search" 16}}<input class="input" type="search" name="search" value="{{filters.search}}" placeholder="Search employee…"></div>
  </form>

  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Employee</th><th>Date</th><th>Recorded</th><th>Requested</th><th>Reason</th><th>Status</th><th>Reviewed</th><th></th></tr></thead>
      <tbody>
        {{#each items}}
        <tr>
          <td><div class="person-cell">{{avatar employee.full_name employee.photo_url 34}}<div><strong>{{employee.full_name}}</strong><span class="text-muted">{{employee.employee_code}} · {{employee.department.name}}</span></div></div></td>
          <td>{{date date}}</td>
          <td>{{#if attendance}}{{time attendance.time_in}} – {{time attendance.time_out}}{{else}}No record{{/if}}</td>
          <td><strong>{{time requested_time_in}} – {{time requested_time_out}}</strong></td>
          <td class="cell-wrap">{{reason}}</td>
          <td>{{badge status "request"}}</td>
          <td>{{#if reviewer}}<span class="small text-muted">{{reviewer.name}}<br>{{datetime reviewed_at}}</span>{{else}}—{{/if}}</td>
          <td class="text-right">
            {{#if (eq status "pending")}}
            <div class="row-actions">
              <button type="button" class="btn btn-success btn-sm" data-modal="#review-modal" data-action="/attendance/corrections/{{id}}/review" data-title="Approve correction" data-subtitle="{{employee.full_name}} · {{date date}}" data-defaults="{{json (object status="approved")}}" data-submit="Approve &amp; update attendance" data-tone="success">{{icon "check" 14}}<span>Approve</span></button>
              <button type="button" class="btn btn-secondary btn-sm" data-modal="#review-modal" data-action="/attendance/corrections/{{id}}/review" data-title="Reject correction" data-subtitle="{{employee.full_name}} · {{date date}}" data-defaults="{{json (object status="rejected")}}" data-submit="Reject request" data-tone="danger">{{icon "x" 14}}<span>Reject</span></button>
            </div>
            {{else}}<span class="small text-muted">{{remarks}}</span>{{/if}}
          </td>
        </tr>
        {{else}}
        <tr><td colspan="8" class="table-empty">{{icon "inbox" 28}}<div>No correction requests.</div></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{> pagination}}
</div>

{{#> modal id="review-modal" title="Review correction" action="" size="sm"}}
<input type="hidden" name="status" value="approved">
<p class="text-muted small">Approving updates the attendance record with the requested times and recalculates lates and overtime.</p>
<label class="field"><span class="field-label">Remarks (optional)</span><textarea class="input" name="remarks" rows="3"></textarea></label>
{{/modal}}
