{{> attendanceNav}}

<div class="card">
  <div class="alert alert-info">Only <strong>approved</strong> overtime is paid in payroll. Overtime is detected automatically when an employee times out at least the configured minimum after the shift ends.</div>
  <form class="filter-bar" method="get" action="/attendance/overtime" data-autosubmit>
    <select class="input" name="overtime_status">{{options opts.requestStatus filters.overtime_status placeholder="All"}}</select>
    <div class="search-input">{{icon "search" 16}}<input class="input" type="search" name="search" value="{{filters.search}}" placeholder="Search employee…"></div>
  </form>

  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Date</th><th>Employee</th><th>Shift</th><th>Scheduled Out</th><th>Actual Out</th><th>Overtime</th><th>Status</th><th></th></tr></thead>
      <tbody>
        {{#each records}}
        <tr>
          <td>{{date date}}</td>
          <td><div class="person-cell">{{avatar employee.full_name employee.photo_url 34}}<div><strong>{{employee.full_name}}</strong><span class="text-muted">{{employee.employee_code}} · {{employee.department.name}}</span></div></div></td>
          <td>{{default shift.name "Rest day duty"}}</td>
          <td>{{time scheduled_out}}</td>
          <td>{{time time_out}}</td>
          <td><strong>{{hours overtime_minutes}}</strong></td>
          <td>{{badge overtime_status "request"}}</td>
          <td class="text-right"><div class="row-actions">
            {{#if (ne overtime_status "approved")}}
            <form method="post" action="/attendance/{{id}}/overtime" class="inline-form">{{> csrf}}<input type="hidden" name="status" value="approved"><button type="submit" class="btn btn-success btn-sm">{{icon "check" 14}}<span>Approve</span></button></form>
            {{/if}}
            {{#if (ne overtime_status "rejected")}}
            <form method="post" action="/attendance/{{id}}/overtime" class="inline-form">{{> csrf}}<input type="hidden" name="status" value="rejected"><button type="submit" class="btn btn-secondary btn-sm">{{icon "x" 14}}<span>Reject</span></button></form>
            {{/if}}
          </div></td>
        </tr>
        {{else}}
        <tr><td colspan="8" class="table-empty">{{icon "inbox" 28}}<div>No overtime records.</div></td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{> pagination}}
</div>
