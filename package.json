{
  "name": "staffpay",
  "version": "1.0.0",
  "description": "StaffPay - Hotel Staff Attendance and Payroll Management System (XianFire Framework)",
  "main": "index.js",
  "type": "module",
  "bin": {
    "xian": "./bin/xian.js"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "xian": "nodemon index.js",
    "migrate": "node migrate.js",
    "migrate:fresh": "node migrate.js --fresh --yes",
    "seed": "node seed.js",
    "setup": "node migrate.js --fresh --yes && node seed.js",
    "mark-absent": "node scripts/mark-absent.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "create:model": "node create.js model",
    "create:controller": "node create.js controller",
    "create:add-middleware": "node create.js middleware",
    "create:upload-middleware": "node create.js upload-middleware",
    "route:list": "node list-routes.js",
    "route:cache": "node route-cache.js"
  },
  "nodemonConfig": {
    "ignore": [
      "public/uploads/*",
      "tests/*",
      "*.sqlite"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.6.1",
    "connect-flash": "^0.1.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-session": "^1.17.3",
    "hbs": "^4.2.0",
    "inquirer": "^9.2.15",
    "jszip": "^3.10.2",
    "multer": "^2.0.2",
    "mysql2": "^3.9.2",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.1"
  }
}
